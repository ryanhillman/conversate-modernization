# Normalize line endings to LF in the repo and on checkout, regardless of
# platform/core.autocrlf, so Windows checkouts don't show every text file as
# changed just from a CRLF/LF mismatch.
* text=auto eol=lf

# Known binary types: never touch line endings in these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
