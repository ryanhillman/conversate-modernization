# Normalize line endings to LF in the repo and on checkout, regardless of
# platform/core.autocrlf. Without this, files checked out with CRLF on
# Windows make tools like `prettier --check`/`ruff format --check` report
# false differences even when the content is identical.
* text=auto eol=lf

# Known binary types: never touch line endings in these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
