VITE_AUTH0_DOMAIN=your-auth0-domain.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-auth0-client-id
VITE_AUTH0_AUDIENCE=https://your-api-identifier
# Leave this commented out for local development — it then falls back to
# http://localhost:5000. For a same-origin deployment (API proxied under
# /api), uncomment it with no value, which sets it to an empty string.
# VITE_API_URL=
