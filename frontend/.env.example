VITE_AUTH0_DOMAIN=your-auth0-domain.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-auth0-client-id
VITE_AUTH0_AUDIENCE=https://your-api-identifier
# The API's origin. Leave this commented out for local development, which
# falls back to http://localhost:5000. Production builds must set it: the
# origin, or no value (an empty string) for a same-origin deployment with the
# API proxied under /api.
# VITE_API_URL=
